--- ./supabase/UPGRADE_V12_4_CUSTOMER_PRIVACY.sql	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/cutflow_repo/CutFlow-v0.12.4/supabase/UPGRADE_V12_4_CUSTOMER_PRIVACY.sql	2026-09-18 10:09:56.000000000 +0000
