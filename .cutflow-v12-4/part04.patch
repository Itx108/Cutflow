+revoke execute on function public.join_public_cutflow_queue_full(text, uuid, text, text, uuid, uuid, text) from public;
+grant execute on function public.join_public_cutflow_queue_full(text, uuid, text, text, uuid, uuid, text) to anon, authenticated;
+
+-- -----------------------------------------------------------------------------
+-- One-time cleanup for already completed records.
+-- First anonymize identities that are no longer required by an active booking or queue.
+-- -----------------------------------------------------------------------------
+update public.customers c
+set full_name = 'Serviced customer',
+    phone = null,
+    email = null,
+    notes = null,
+    birthday = null,
+    preferred_staff_id = null,
+    marketing_opt_in = false,
+    is_anonymized = true
+where coalesce(c.is_anonymized, false) = false
+  and (
+    exists (
+      select 1 from public.appointments a
+      where a.customer_id = c.id and a.status = 'completed'
+    )
+    or exists (
+      select 1 from public.walk_ins w
+      where w.customer_id = c.id and w.status = 'completed'
+    )
+  )
+  and not exists (
+    select 1 from public.appointments a
+    where a.customer_id = c.id
+      and a.status not in ('completed', 'cancelled', 'no_show')
+  )
+  and not exists (
+    select 1 from public.walk_ins w
+    where w.customer_id = c.id
+      and w.status in ('waiting', 'called', 'in_service')
+  );
+
+-- Remove PII from all completed operational records, including records belonging
+-- to customers who still have another active booking.
+delete from public.notifications n
+using public.appointments a
+where n.appointment_id = a.id
+  and a.status = 'completed';
+
+update public.appointments
+set customer_id = null,
+    notes = null
+where status = 'completed';
+
+update public.walk_ins
+set customer_id = null,
+    customer_name = 'Serviced customer',
+    phone = null,
+    notes = null
+where status = 'completed';
