.business_settings where business_id = b.id;
+  if not found or not s.public_queue_enabled then raise exception 'The walk-in queue is not currently available.'; end if;
+
+  if p_service_id is not null then
+    select duration_minutes into duration_value from public.services
+    where id = p_service_id and business_id = b.id and is_active = true;
+    if not found then raise exception 'Service is not available.'; end if;
+  end if;
+
+  if p_staff_id is not null then
+    if not exists (select 1 from public.staff where id = p_staff_id and business_id = b.id and is_active = true) then
+      raise exception 'Staff member is not available.';
+    end if;
+    if p_service_id is not null and not exists (
+      select 1 from public.staff_services where staff_id = p_staff_id and service_id = p_service_id
+    ) then
+      raise exception 'Selected staff member does not provide this service.';
+    end if;
+  end if;
+
+  if p_branch_id is not null then
+    select * into br from public.branches where id = p_branch_id and business_id = b.id and is_active = true;
+    if not found then raise exception 'Branch is not available.'; end if;
+  else
+    select * into br from public.branches where business_id = b.id and is_active = true order by created_at limit 1;
+  end if;
+
+  if p_staff_id is not null and exists (
+    select 1 from public.staff
+    where id = p_staff_id and branch_id is not null and branch_id is distinct from br.id
+  ) then
+    raise exception 'Selected staff member is assigned to another branch.';
+  end if;
+
+  insert into public.walk_ins (
+    business_id, branch_id, customer_id, staff_id, service_id, customer_name, phone,
+    ticket_code, estimated_minutes, notes
+  ) values (
+    b.id, br.id, null, p_staff_id, p_service_id, btrim(p_customer_name), btrim(p_phone),
+    upper(substr(md5(random()::text || clock_timestamp()::text), 1, 6)), duration_value, nullif(btrim(p_notes), '')
+  ) returning * into w;
+
+  select count(*)::integer into pos from public.walk_ins
+  where business_id = b.id and status in ('waiting', 'called') and joined_at <= w.joined_at;
+
+  return jsonb_build_object('ticket_id', w.id, 'ticket_code', w.ticket_code, 'position', pos, 'status', w.status);
+end;
+$$;
